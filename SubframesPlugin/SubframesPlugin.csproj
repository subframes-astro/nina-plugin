<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Subframes.NinaPlugin</AssemblyName>
    <RootNamespace>Subframes.NinaPlugin</RootNamespace>
    <Version>0.1.21</Version>
    <!-- Ensure all NuGet dependency DLLs are copied to the build output dir.
         NINA's AssemblyResolve hook looks in the plugin subfolder, so all
         managed dependencies must be present there alongside the plugin DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Authors>Subframes</Authors>
    <Company>Subframes</Company>
    <AssemblyTitle>Subframes</AssemblyTitle>
    <Description>NINA plugin for Subframes — captures exposure data and posts to the Subframes API.</Description>
  </PropertyGroup>

  <!--
    NINA SDK References
    ==================
    Set the NinaSdkPath property to point at your NINA installation (or an extracted SDK zip).
    Default assumes a `lib\nina-sdk` folder next to this .csproj containing the NINA assemblies.

    Override at build time:
      msbuild /p:NinaSdkPath="C:\Program Files\N.I.N.A"
    Or set the environment variable NINA_SDK_PATH before building.
  -->
  <PropertyGroup>
    <NinaSdkPath Condition="'$(NinaSdkPath)' == '' And '$(NINA_SDK_PATH)' != ''">$(NINA_SDK_PATH)</NinaSdkPath>
    <NinaSdkPath Condition="'$(NinaSdkPath)' == ''">$(MSBuildThisFileDirectory)lib\nina-sdk</NinaSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NINA.Core">
      <HintPath>$(NinaSdkPath)\NINA.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Plugin">
      <HintPath>$(NinaSdkPath)\NINA.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Equipment">
      <HintPath>$(NinaSdkPath)\NINA.Equipment.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Sequencer">
      <HintPath>$(NinaSdkPath)\NINA.Sequencer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Astrometry">
      <HintPath>$(NinaSdkPath)\NINA.Astrometry.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.WPF.Base">
      <HintPath>$(NinaSdkPath)\NINA.WPF.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Profile">
      <HintPath>$(NinaSdkPath)\NINA.Profile.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NINA.Image">
      <HintPath>$(NinaSdkPath)\NINA.Image.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- System.ComponentModel.Composition for MEF exports -->
    <PackageReference Include="System.ComponentModel.Composition" Version="8.*" />
    <!-- MVVM source generators for [ObservableProperty], [RelayCommand] etc. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <!-- SQLite for offline frame caching.
         Use Core (no bundled native) + winsqlite3 so we rely on Windows' built-in
         winsqlite3.dll (Win 8.1+) and avoid distributing a native e_sqlite3.dll. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.*" />
  </ItemGroup>

  <!-- Assembly attributes consumed by NINA's PluginBase to populate manifest metadata -->
  <ItemGroup>
    <!-- GUID uniquely identifies this plugin to NINA's plugin system -->
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>3ae05d9d-f170-5182-a0c1-75c76a1154f4</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MinimumApplicationVersion</_Parameter1>
      <_Parameter2>3.1.0.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
