<UserControl
    x:Class="Subframes.NinaPlugin.UI.OptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Subframes.NinaPlugin.UI"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="10" HorizontalAlignment="Stretch">

        <!-- Title -->
        <TextBlock
            Text="Subframes Plugin Settings"
            FontWeight="SemiBold"
            FontSize="14"
            Margin="0,0,0,12"
            Foreground="{DynamicResource PrimaryBrush}" />

        <!-- Enable/Disable toggle -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox
                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                Content="Send data to Subframes API"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- Debug logging toggle -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock
                Text="Debug:"
                VerticalAlignment="Center"
                Margin="0,0,6,0"
                Foreground="{DynamicResource PrimaryBrush}" />
            <CheckBox
                IsChecked="{Binding IsDebugEnabled, Mode=TwoWay}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- API Base URL -->
        <TextBlock
            Text="API Base URL"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <TextBox
            Text="{Binding ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="e.g. http://localhost:8080"
            Margin="0,0,0,12" />

        <!-- API Key -->
        <TextBlock
            Text="API Key"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <PasswordBox
            x:Name="ApiKeyBox"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="Your Subframes API key (starts with astk_live_)"
            Margin="0,0,0,4"
            PasswordChanged="ApiKeyBox_PasswordChanged" />

        <!-- API Connection Status -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button
                Content="Test Connection"
                Command="{Binding CheckApiConnectionCommand}"
                IsEnabled="{Binding IsEnabled}"
                Padding="8,2"
                FontSize="11"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
            <Ellipse
                Width="10" Height="10"
                Fill="{Binding ApiStatusBrush}"
                VerticalAlignment="Center"
                Margin="0,0,6,0" />
            <TextBlock
                Text="{Binding ApiStatusText}"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SecondaryBrush}"
                FontSize="12" />
        </StackPanel>

        <!-- Instance ID (read-only) -->
        <TextBlock
            Text="Instance ID"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <TextBox
            Text="{Binding InstanceId, Mode=OneWay}"
            IsReadOnly="True"
            Margin="0,0,0,12" />

        <!-- Instance Name -->
        <TextBlock
            Text="Instance Name"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <TextBox
            Text="{Binding InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="Friendly name for this NINA instance (e.g. Main Scope, Widefield Rig)"
            Margin="0,0,0,12" />

        <!-- Target Scheduler Settings -->
        <Separator Margin="0,8,0,8" />

        <TextBlock
            Text="Target Scheduler Settings"
            FontWeight="SemiBold"
            FontSize="13"
            Margin="0,0,0,8"
            Foreground="{DynamicResource PrimaryBrush}" />

        <!-- TS API Port -->
        <TextBlock
            Text="TS API Port"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <TextBox
            Text="{Binding TsApiPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Target Scheduler local HTTP API port (default: 8188)"
            Margin="0,0,0,12" />

        <!-- TS Database Path -->
        <TextBlock
            Text="TS Database Path"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <TextBox
            Text="{Binding TsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Path to targetscheduler.db — leave blank for default: %localappdata%\NINA\TargetScheduler\targetscheduler.db"
            Margin="0,0,0,12" />

        <!-- TS Profile Selector (shown only when multiple profiles are available) -->
        <StackPanel
            Visibility="{Binding ShowProfileSelector, Converter={StaticResource BoolToVis}}"
            Margin="0,0,0,12">
            <TextBlock
                Text="TS Profile"
                Margin="0,0,0,4"
                Foreground="{DynamicResource PrimaryBrush}" />
            <ComboBox
                ItemsSource="{Binding TsProfiles}"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"
                SelectedValue="{Binding SelectedTsProfileId, Mode=TwoWay}"
                ToolTip="Select the Target Scheduler profile to use for tonight's plan preview" />
        </StackPanel>

        <!-- Save button -->
        <Button
            Content="Save Settings"
            Command="{Binding SaveCommand}"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Padding="12,4" />

        <!-- Separator -->
        <Separator Margin="0,8,0,8" />

        <!-- Live session status -->
        <TextBlock
            Text="Session Status"
            FontWeight="SemiBold"
            Margin="0,0,0,4"
            Foreground="{DynamicResource PrimaryBrush}" />
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Text="{Binding StatusMessage}"
                Foreground="{DynamicResource PrimaryBrush}"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
            <Button
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                Padding="8,2"
                FontSize="11" />
        </StackPanel>

    </StackPanel>
</UserControl>
