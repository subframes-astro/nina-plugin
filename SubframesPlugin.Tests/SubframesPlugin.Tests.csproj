<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- SQLite for DeadLetterStore tests -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.*" />
  </ItemGroup>

  <!--
    CatalogNameNormalizer has no NINA SDK dependencies, so we compile it
    directly into the test project rather than referencing the WPF plugin assembly.
  -->
  <ItemGroup>
    <Compile Include="../SubframesPlugin/CatalogNameNormalizer.cs" />
    <Compile Include="../SubframesPlugin/FrameTypeFilter.cs" />
    <Compile Include="../SubframesPlugin/Api/Dtos.cs" />
    <Compile Include="../SubframesPlugin/AutofocusEventBuilder.cs" />
    <!-- Guide sample subsystem: compiled directly (no NINA SDK dependencies) -->
    <Compile Include="../SubframesPlugin/Guiding/GuideSampleModels.cs" />
    <Compile Include="../SubframesPlugin/Guiding/ApiUploadResult.cs" />
    <Compile Include="../SubframesPlugin/Guiding/ISessionContext.cs" />
    <Compile Include="../SubframesPlugin/Guiding/IGuideSamplesApi.cs" />
    <Compile Include="../SubframesPlugin/Guiding/GuideSampleBatchUploader.cs" />
    <Compile Include="../SubframesPlugin/Api/DeadLetterStore.cs" />
    <!-- StarAnalysisExtractor: pure reflection, no NINA SDK dependencies -->
    <Compile Include="../SubframesPlugin/Imaging/StarAnalysisExtractor.cs" />
  </ItemGroup>

</Project>
